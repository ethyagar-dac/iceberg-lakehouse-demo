# Copy to .env (the devcontainer does this automatically). .env is gitignored.
# Local-only credentials; never reuse real ones here.

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
AWS_REGION=us-east-1

# Used by Python scripts running in the codespace itself (outside Docker),
# which reach the containers through their published ports on localhost.
S3_ENDPOINT=http://localhost:9000
CATALOG_URI=http://localhost:8181
